# Environment
ENV=development
PORT=8000

# AI Models (Gemini & Anthropic Claude Sonnet)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Flight APIs
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
GALILEO_API_URL=
GALILEO_TARGET_BRANCH=
GALILEO_CREDENTIALS=
INDIGO_AGENT_ID=
INDIGO_API_KEY=

# Hotel API (TBO Holidays)
TBO_USERNAME=
TBO_PASSWORD=
TBO_API_URL=http://api.tbotechnology.net/HotelAPI_V10/HotelService.svc

# Dining / Restaurant API
RESTAURANT_API_BASE_URL=
RESTAURANT_API_KEY=

# Payment Gateway (Razorpay / Stripe)
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=

# Firebase project id (verifies login tokens). In development without it, send an X-Dev-User header.
FIREBASE_PROJECT_ID=
# Fernet key for encrypting stored Swiggy tokens (required when ENV=production).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SWIGGY_TOKEN_ENCRYPTION_KEY=
# App user whose Swiggy account serves read-only discovery before a user connects their own.
SWIGGY_SERVICE_USER_ID=
